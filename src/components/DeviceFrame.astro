---
import DeviceBody from './DeviceBody.astro';

/**
 * A drawn stand-in for a screen, on a real device body.
 *
 * The compositions are arbitrary; they exist so two projects side by side do
 * not read as the same image repeated. The hardware comes from `DeviceBody`,
 * the same one a real capture gets, so a project still waiting for screenshots
 * sits beside one that has them without the two looking unrelated.
 *
 * TODO: delete this once every project has real screenshots. Only the slabs
 * are a placeholder; the body they sit in is not.
 */
type Slab = { h?: number; accent?: boolean; fill?: boolean };

const SLABS: Record<'phone' | 'window', Slab[][]> = {
  phone: [
    [{ h: 40, accent: true }, { h: 24 }, { fill: true }],
    [{ h: 52 }, { h: 24, accent: true }, { fill: true }],
    [{ h: 32 }, { h: 32 }, { accent: true, fill: true }],
  ],
  window: [
    [{ h: 34, accent: true }, { fill: true }],
    [{ h: 26 }, { accent: true, fill: true }],
    [{ h: 44, accent: true }, { fill: true }],
  ],
};

interface Props {
  kind?: 'phone' | 'window';
  size?: 'default' | 'wide' | 'shot';
  /** Picks one of three compositions. */
  variant?: 0 | 1 | 2;
  class?: string;
}

const {
  kind = 'phone',
  size = 'default',
  variant = 0,
  class: className,
} = Astro.props;

const slabs = SLABS[kind][variant];

/** The capture's own ratio, so a stand-in is the shape of a real screen. */
const screen = kind === 'phone' ? 'aspect-[1320/2868]' : 'aspect-[4/3]';
const radius =
  kind === 'phone'
    ? 'rounded-[calc(var(--shot-w)*0.120)]'
    : 'rounded-[calc(var(--shot-w)*0.028)]';
---

<DeviceBody kind={kind} size={size} class={className}>
  <div
    class:list={[
      /* `bg-canvas`, not `bg-panel`: a panel is translucent, and over the dark
        body it greys down until the slabs on it stop reading. */
      'flex flex-col gap-1.5 overflow-hidden bg-canvas p-2',
      screen,
      radius,
    ]}
    aria-hidden="true"
  >
    {
      kind === 'window' && (
        <div class="flex gap-1 pb-1">
          <i class="block size-1.5 rounded-full bg-line-strong" />
          <i class="block size-1.5 rounded-full bg-line-strong" />
          <i class="block size-1.5 rounded-full bg-line-strong" />
        </div>
      )
    }

    <div
      class:list={[
        'h-[7px] rounded bg-line',
        variant % 2 === 0 ? 'w-3/5' : 'w-2/5',
      ]}
    >
    </div>

    {
      slabs.map((slab) => (
        <div
          class:list={[
            kind === 'phone' ? 'rounded-[10px]' : 'rounded-sm',
            slab.fill && 'flex-1',
            slab.accent
              ? 'bg-linear-100 from-violet to-cyan opacity-55'
              : 'bg-line',
          ]}
          style={slab.h ? `height: ${slab.h}px` : undefined}
        />
      ))
    }
  </div>
</DeviceBody>
