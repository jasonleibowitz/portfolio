---
import type { CollectionEntry } from 'astro:content';
import Artwork from '@components/Artwork.astro';
import { Icon } from 'astro-icon/components';
import { tv } from '@lib/tv';
import { splitYear } from '@lib/lists';
import Chip from './ui/Chip.astro';
import Ph from './ui/Ph.astro';
import Typography from './ui/Typography.astro';

/**
 * The artwork is 56 px wide in the two shapes, so the column is the same in all
 * lists. Do not use 40 px: a film poster that small shows no title and no face.
 *
 * Do not add `row-span-*`: a span hard-codes a count of the rows of text. One
 * column child holds all of the text, so the entry is one grid row at any
 * length.
 */
const artwork = tv({
  base: 'mt-1 w-14 rounded-md border border-line object-cover',
  variants: {
    shape: {
      square: 'aspect-square',
      poster: 'aspect-[2/3]',
    },
  },
});

/** For the width and height attributes only. They reserve space before layout. */
const ARTWORK_HEIGHT = { square: 56, poster: 84 } as const;

/** No artwork means no artwork track, so no list has an empty 56 px column. */
const columns = tv({
  base: 'grid items-start gap-x-4',
  variants: {
    rank: { true: '', false: '' },
    art: { true: '', false: '' },
  },
  compoundVariants: [
    { rank: true, art: true, class: 'grid-cols-[2.75rem_56px_minmax(0,1fr)]' },
    { rank: true, art: false, class: 'grid-cols-[2.75rem_minmax(0,1fr)]' },
    { rank: false, art: true, class: 'grid-cols-[56px_minmax(0,1fr)]' },
    { rank: false, art: false, class: 'grid-cols-[minmax(0,1fr)]' },
  ],
});

/** From the schema, so the two cannot become different. */
type Item = CollectionEntry<'lists'>['data']['items'][number];

interface Props {
  item: Item;
  /**
   * The position in the full list. Do not use `<ol>` numbering or a CSS
   * counter: the filter hides rows, and the rank would start again at one.
   */
  rank?: number;
  /** Set one time for each list. See the `thumb` field in the schema. */
  shape?: 'square' | 'poster';
}

const { item, rank, shape = 'square' } = Astro.props;

const isLink = Boolean(item.href);

const { title, year } = splitYear(item.name);

/**
 * The arrow stays with the last word so the two wrap together, and the arrow
 * never lands alone on a line below the title.
 */
const words = title.split(' ');
const lead = words.slice(0, -1).join(' ');
const lastWord = words.at(-1);
---

{
  /* `-mx-3 px-3` moves the rule and the hover tint past the text, but not the
  text itself, so the column stays on the page gutter. */
}
<li
  data-tags={item.tags.join(' ')}
  class:list={[
    'entry group relative -mx-3 border-b border-line px-3 py-3 last:border-0 [&[hidden]]:hidden',
    columns({ rank: Boolean(rank), art: Boolean(item.image) }),
    isLink && 'transition-colors duration-150 hover:bg-panel',
  ]}
>
  {
    rank && (
      <span class="font-display text-[2rem] leading-[1.15] font-bold text-faint tabular-nums">
        {rank}
      </span>
    )
  }

  {
    item.image && (
      <Artwork
        src={item.image}
        width={56}
        height={ARTWORK_HEIGHT[shape]}
        class={artwork({ shape })}
      />
    )
  }

  <div class="flex min-w-0 flex-col gap-1">
    {
      /* The year sits in the title's row, not the meta row, so it makes a second
    aligned column. `items-baseline` holds it on line one when a title wraps. */
    }
    <span
      class="flex items-baseline justify-between gap-x-4 font-semibold tracking-[-0.01em]"
    >
      {
        /* The link holds the title only, so the accessible name is the title.
        The pseudo-element makes the whole row clickable. */
      }
      {
        isLink ? (
          <a
            href={item.href}
            target="_blank"
            rel="noreferrer noopener"
            class="no-underline after:absolute after:inset-0 group-hover:text-violet"
          >
            <Ph when={item.placeholder.includes('name')}>
              {lead && `${lead} `}
              <span class="whitespace-nowrap">
                {lastWord}
                <Icon
                  name="lucide:arrow-up-right"
                  class="ml-1 inline-block size-3.5 translate-y-px opacity-45 transition-[opacity,transform] duration-150 group-hover:translate-x-px group-hover:opacity-100"
                />
              </span>
            </Ph>
          </a>
        ) : (
          <Ph when={item.placeholder.includes('name')} class="text-ink">
            {title}
          </Ph>
        )
      }
      {
        year && (
          <Typography variant="data" class="shrink-0 tabular-nums">
            {year}
          </Typography>
        )
      }
    </span>

    {
      /* Above the note: the subtitle identifies the item, the note is an
      opinion about it. */
      item.subtitle && (
        <Ph
          as="p"
          when={item.placeholder.includes('subtitle')}
          variant="data"
          class="text-muted"
        >
          {item.subtitle}
        </Ph>
      )
    }

    {
      item.note && (
        <Ph
          as="p"
          when={item.placeholder.includes('note')}
          variant="footnote"
          class="max-w-[68ch] text-muted"
        >
          {item.note}
        </Ph>
      )
    }

    {
      item.tags.length > 0 && (
        <span class="mt-0.5 flex flex-wrap items-center gap-x-2 gap-y-1.5">
          {item.tags.map((tag) => (
            <Chip size="mini">{tag}</Chip>
          ))}
        </span>
      )
    }
  </div>
</li>
