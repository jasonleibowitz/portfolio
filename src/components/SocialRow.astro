---
import { Icon } from 'astro-icon/components';
import { SOCIALS, AVATAR_SOCIALS, type Social } from '@lib/site';

/**
 * Icon-only by convention. The name lives in aria-label, so each link still
 * announces properly; pill chrome here competed with the avatar above it.
 *
 * `swap` marks the row that drives the homepage avatar swap.
 */
interface Props {
  variant?: 'full' | 'avatar';
  swap?: boolean;
  class?: string;
}

const { variant = 'full', swap = false, class: className } = Astro.props;
const items: Social[] = variant === 'full' ? SOCIALS : AVATAR_SOCIALS;
---

<div class:list={['flex flex-wrap gap-1', className]}>
  {
    items.map((social) => (
      <a
        href={social.href}
        aria-label={social.label}
        data-swap={swap ? social.key : undefined}
        {...(social.key === 'rss'
          ? {}
          : { target: '_blank', rel: 'noreferrer noopener' })}
        class="inline-flex size-11 items-center justify-center rounded-full text-faint no-underline transition-[color,background] duration-150 hover:bg-panel hover:text-ink aria-[current=true]:bg-violet/12 aria-[current=true]:text-violet"
      >
        <Icon name={social.icon} class="size-5 shrink-0" />
      </a>
    ))
  }
</div>
