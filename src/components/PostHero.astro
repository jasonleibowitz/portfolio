---
/* Only TypeScript sees `ImageMetadata` as a global. Import it, or eslint
   `no-undef` reports it. `OrbitAvatar` does the same. */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

/**
 * The picture at the top of a post, in the design's 16:9 band.
 *
 * The band is the same on every post, and a cover can have any ratio, thus
 * sharp cuts each file to it. The width is the measure, because the column is
 * 46rem and no more.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
}

const { src, alt } = Astro.props;

/* 46rem at a 16px root, at 16:9. The media query below keeps the rem, which is
   what a reader who scales the text gets. */
const WIDTH = 736;
const HEIGHT = Math.round((WIDTH * 9) / 16);
---

<figure class="mb-12">
  <Image
    src={src}
    alt={alt}
    width={WIDTH}
    height={HEIGHT}
    fit="cover"
    sizes={`(min-width: 46rem) ${WIDTH}px, 100vw`}
    class="aspect-video w-full rounded-card object-cover shadow-lift"
    loading="eager"
  />
</figure>
