---
/**
 * The JL monogram: one module drawn twice, in ink on warm paper with the
 * aurora in the corners. Each letter is a stem and a turn, and the only
 * difference between them is that the J turns on a radius and the L turns
 * square. Thus the pair is one constructed mark rather than two letters.
 *
 * `public/favicon.svg` is the same mark, kept correct by hand. Change the two
 * together, then run `pnpm cards` to draw the touch icon again. The gradients
 * are in this file, thus the mark is complete anywhere a person puts it.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 100 100" aria-hidden="true">
  <defs>
    <radialGradient id="jl-a" cx="12%" cy="8%" r="32%">
      <stop offset="0" stop-color="#5b3df5" stop-opacity=".34"></stop>
      <stop offset="1" stop-color="#5b3df5" stop-opacity="0"></stop>
    </radialGradient>
    <radialGradient id="jl-b" cx="88%" cy="22%" r="32%">
      <stop offset="0" stop-color="#0e9fb8" stop-opacity=".28"></stop>
      <stop offset="1" stop-color="#0e9fb8" stop-opacity="0"></stop>
    </radialGradient>
    <radialGradient id="jl-c" cx="60%" cy="92%" r="32%">
      <stop offset="0" stop-color="#5b3df5" stop-opacity=".19"></stop>
      <stop offset="1" stop-color="#5b3df5" stop-opacity="0"></stop>
    </radialGradient>
  </defs>
  <rect
    width="100"
    height="100"
    rx="28"
    fill="#fcfaf6"
    stroke="#131220"
    stroke-opacity=".16"
    stroke-width="5"></rect>
  <rect width="100" height="100" rx="28" fill="url(#jl-a)"></rect>
  <rect width="100" height="100" rx="28" fill="url(#jl-b)"></rect>
  <rect width="100" height="100" rx="28" fill="url(#jl-c)"></rect>
  <g
    fill="none"
    stroke="#131220"
    stroke-width="14"
    stroke-linecap="butt"
    stroke-linejoin="miter"
  >
    <path d="M42 21V56A17 17 0 0 1 25 73"></path>
    <path d="M60 21V72H83"></path>
  </g>
</svg>
