---
/**
 * Content plus a 220px sidebar, stacking to one column on narrow screens.
 * Used by the pages that pair a list with a tag filter.
 *
 * The child picks its side: `TagRail` sits right via `rail:order-last`, and
 * renders first in the DOM so keyboard users reach the filter before the list.
 *
 * Keep `minmax(0,1fr)` and `min-w-0` — without them a chip row measures to
 * max-content and drags the page ~400px wide at 320px.
 */
interface Props {
  class?: string;
}

const { class: className, ...rest } = Astro.props;
---

<div
  class:list={[
    'grid grid-cols-[minmax(0,1fr)] gap-8 [&>*]:min-w-0',
    'rail:grid-cols-[minmax(0,1fr)_220px] rail:items-start rail:gap-16',
    className,
  ]}
  {...rest}
>
  <slot />
</div>
