---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { AVATAR_SOCIALS, type SocialKey } from '@lib/site';

import headshot from '@images/headshot.png';
import github from '@images/githubprofile.png';
import linkedin from '@images/linkedinprofile.png';
import twitter from '@images/twitterprofile.png';
import instagram from '@images/instagramprofile.png';

/**
 * The headshot, ringed by an orbiting dot, that swaps to the profile picture
 * for whichever social chip you are on. Hover and focus on pointer devices, tap
 * on touch, where the chip stays lit until you tap another.
 *
 * The images are imported rather than referenced from public/ so they go
 * through astro:assets: five 500px PNGs is ~900kB of source for something that
 * renders at 250px.
 */
const AVATARS: Record<SocialKey | 'default', ImageMetadata | null> = {
  default: headshot,
  github,
  linkedin,
  twitter,
  instagram,
  rss: null,
};
---

<div class="relative aspect-square w-[200px] shrink-0 nav:w-[250px]">
  <div
    class="animate-orbit absolute inset-0 rounded-full border border-dashed border-line-strong after:absolute after:top-[-4px] after:left-1/2 after:-ml-1 after:size-2 after:rounded-full after:shadow-[0_0_12px_var(--color-glow-a)] after:content-[''] after:spectrum-fill"
    aria-hidden="true"
  >
  </div>

  <div
    id="orbit-avatar"
    class="absolute inset-3.5 overflow-hidden rounded-full shadow-lift"
  >
    <Image
      src={headshot}
      alt="Jason Leibowitz"
      width={250}
      densities={[1, 2]}
      class="avatar-shot absolute inset-0 size-full scale-[1.04] object-cover opacity-0 transition-[opacity,transform] duration-[320ms] data-[active]:scale-100 data-[active]:opacity-100"
      data-active
      data-key="default"
    />
    {
      AVATAR_SOCIALS.map((social) => {
        const image = AVATARS[social.key];
        return (
          image && (
            <Image
              src={image}
              alt=""
              width={250}
              densities={[1, 2]}
              class="avatar-shot absolute inset-0 size-full scale-[1.04] object-cover opacity-0 transition-[opacity,transform] duration-[320ms] data-[active]:scale-100 data-[active]:opacity-100"
              data-key={social.key}
              aria-hidden="true"
            />
          )
        );
      })
    }
  </div>
</div>

<script>
  const shots = document.querySelectorAll<HTMLElement>(
    '#orbit-avatar .avatar-shot'
  );
  const chips = document.querySelectorAll<HTMLElement>('[data-swap]');

  if (shots.length && chips.length) {
    const canHover = window.matchMedia('(hover: hover)').matches;

    const show = (key: string) => {
      shots.forEach((shot) =>
        shot.toggleAttribute('data-active', shot.dataset.key === key)
      );
      chips.forEach((chip) =>
        chip.setAttribute('aria-current', String(chip.dataset.swap === key))
      );
    };

    chips.forEach((chip) => {
      const key = chip.dataset.swap!;

      if (canHover) {
        chip.addEventListener('mouseenter', () => show(key));
        chip.addEventListener('mouseleave', () => show('default'));
        chip.addEventListener('focus', () => show(key));
        chip.addEventListener('blur', () => show('default'));
      }

      // On touch the chip is the only affordance, so tapping toggles it and
      // the picture stays put until another chip is tapped.
      chip.addEventListener('click', (event) => {
        event.preventDefault();
        show(chip.getAttribute('aria-current') === 'true' ? 'default' : key);
      });
    });
  }
</script>
