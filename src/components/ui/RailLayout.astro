---
/**
 * Content plus a sticky rail; one column below 52rem.
 *
 * Both `minmax(0, 1fr)` and the `min-w-0` on the children matter: the rail is a
 * flex row of chips, and in an auto-sized grid track it measures to max-content
 * and drags the whole page ~400px wide at a 320px viewport.
 */
interface Props {
  class?: string;
}

const { class: className, ...rest } = Astro.props;
---

<div
  class:list={[
    'grid grid-cols-[minmax(0,1fr)] gap-8 [&>*]:min-w-0',
    'rail:grid-cols-[minmax(0,1fr)_220px] rail:items-start rail:gap-16',
    className,
  ]}
  {...rest}
>
  <slot />
</div>
