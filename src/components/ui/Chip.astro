---
import { tv } from 'tailwind-variants';

const chip = tv({
  base: 'rounded-full border px-2.5 py-1 font-mono text-[0.6875rem] tracking-[0.04em] text-muted',
  variants: {
    size: {
      // Stack chips and project chips.
      default: 'border-line',
      // The inline tag markers on a row, which sit inside a meta line.
      mini: 'border-line px-2 py-0.5',
    },
    accent: {
      none: '',
      violet: 'border-violet/45',
    },
  },
  defaultVariants: { size: 'default', accent: 'none' },
});

interface Props {
  size?: 'default' | 'mini';
  accent?: 'none' | 'violet';
  class?: string;
}

const { size, accent, class: className } = Astro.props;
---

<span class={chip({ size, accent, class: className })}><slot /></span>
