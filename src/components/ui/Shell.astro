---
/** The page's horizontal container. Every full-width band uses one. */
interface Props {
  as?: 'div' | 'section' | 'article' | 'header' | 'footer' | 'aside' | 'nav';
  class?: string;
}

const { as: Tag = 'div', class: className, ...rest } = Astro.props;
---

<Tag
  class:list={['mx-auto w-full max-w-shell px-(--gutter)', className]}
  {...rest}
>
  <slot />
</Tag>
