---
/** Mono, uppercase, letterspaced — the label above a heading. */
interface Props {
  as?: 'p' | 'span' | 'div';
  class?: string;
}

const { as: Tag = 'p', class: className, ...rest } = Astro.props;
---

<Tag
  class:list={[
    'font-mono text-meta tracking-[0.16em] text-faint uppercase',
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
