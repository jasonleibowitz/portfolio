---
import Typography from './Typography.astro';
import type { TypographyVariant } from '@lib/typography';

/**
 * Marks copy that is still waiting on Jason. The gap stays visible on the page
 * rather than being described in a document, and nothing gets invented to fill
 * it in the meantime.
 *
 * TODO: delete this once no `placeholder` frontmatter remains.
 *
 * Pass `variant` when the copy sets its own type; omit it where the copy
 * inherits from whatever it sits inside.
 */
interface Props {
  variant?: TypographyVariant;
  as?: 'span' | 'p' | 'dd' | 'li' | 'figcaption' | 'b' | 'time';
  /** Pass through a frontmatter flag; false renders the copy unmarked. */
  when?: boolean;
  class?: string;
}

const {
  variant,
  as: Tag = 'span',
  when = true,
  class: className,
  ...rest
} = Astro.props as Props;

const marked = [when && 'placeholder-copy', className]
  .filter(Boolean)
  .join(' ');
---

{
  variant ? (
    <Typography variant={variant} as={Tag} class={marked} {...rest}>
      <slot />
    </Typography>
  ) : (
    <Tag class={marked} {...rest}>
      <slot />
    </Tag>
  )
}
