---
import Typography from './Typography.astro';
import Link from './Link.astro';
/** Section title, with an optional link out to the full thing. */
interface Props {
  title: string;
  more?: { label: string; href: string };
  class?: string;
}

const { title, more, class: className } = Astro.props;
---

<div class:list={['mb-6 flex items-baseline justify-between gap-4', className]}>
  <Typography variant="heading2">{title}</Typography>
  {
    more && (
      <Link
        variant="compact"
        class="text-muted hover:text-violet whitespace-nowrap"
        href={more.href}
      >
        {more.label} →
      </Link>
    )
  }
</div>
