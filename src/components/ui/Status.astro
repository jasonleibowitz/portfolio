---
import type { CollectionEntry } from 'astro:content';
import { tv } from '@lib/tv';
import Typography from './Typography.astro';

/**
 * A project's stage: a coloured dot beside the word for it.
 *
 * The dot is keyed to `status` and never to anything else. An earlier version
 * keyed it to a separate "actively moving" flag, which meant two projects
 * reading `Beta` carried different dots for a reason nothing on the page
 * explained. Colour here only ever repeats the label beside it.
 *
 * Testing pulses because it is the stage that is going somewhere; the other
 * two are steady states.
 */
const dot = tv({
  base: 'block size-[7px] rounded-full',
  variants: {
    status: {
      live: 'bg-stage-live',
      testing: 'animate-status bg-stage-testing',
      development: 'bg-stage-development',
    },
  },
});

/**
 * Read off the `projects` schema rather than restated, so adding a stage in
 * `content.config.ts` is a type error here until this component handles it.
 */
export type ProjectStatus = CollectionEntry<'projects'>['data']['status'];

/**
 * The word beside the dot, keyed to `status` so the two cannot disagree. Every
 * project at a stage says the same thing about it, thus the word belongs to
 * the stage and not to the entry.
 */
const LABEL: Record<ProjectStatus, string> = {
  development: 'In Development',
  testing: 'In Beta',
  live: 'Live',
};

interface Props {
  status: ProjectStatus;
  class?: string;
}

const { status, class: className } = Astro.props;
---

<Typography
  variant="caption"
  as="span"
  class:list={['inline-flex items-center gap-[7px] text-muted', className]}
>
  <i class={dot({ status })}></i>{LABEL[status]}
</Typography>
