---
import { Icon } from 'astro-icon/components';
import { tv } from 'tailwind-variants';

const button = tv({
  base: [
    'inline-flex min-h-[50px] items-center gap-2 rounded-full px-[22px]',
    'text-ui font-semibold no-underline',
    'transition-[transform,box-shadow] duration-200 ease-[cubic-bezier(0.2,0.8,0.2,1)]',
    'hover:-translate-y-0.5 hover:shadow-lift',
  ],
  variants: {
    variant: {
      default: 'border border-line bg-panel text-ink',
      // The gradient carries the ink colour of the *opposite* theme, so the
      // label stays readable against it in both.
      primary:
        'border border-transparent bg-linear-100 from-violet to-cyan text-white dark:text-[#14141d]',
    },
  },
  defaultVariants: { variant: 'default' },
});

interface Props {
  href: string;
  variant?: 'default' | 'primary';
  icon?: string;
  class?: string;
  'data-astro-prefetch'?: boolean;
}

const { href, variant, icon, class: className, ...rest } = Astro.props;
---

<a href={href} class={button({ variant, class: className })} {...rest}>
  {icon && <Icon name={icon} class="size-5 shrink-0" />}
  <slot />
</a>
