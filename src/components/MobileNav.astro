---
import { Icon } from 'astro-icon/components';
import Button from './ui/Button.astro';
import { EMAIL, NAV, NAV_FOR_PAGE, RESUME_HREF, type PageKey } from '@lib/site';

/**
 * The mobile nav: one corner control that raises destinations and the two
 * contact CTAs.
 *
 * A full-width bar cannot work here. Safari keeps its own translucent capsule
 * at the bottom of the viewport, so a second one 12px above it reads as a
 * duplicate of the browser rather than as part of the page. A single control
 * in the right corner clears Safari's centered URL field and gives the page
 * back the width.
 *
 * Closed, it names the current section: visitors arrive on any page, so "where
 * am I" is real information. It shrinks to the spectrum node alone on scroll
 * down.
 *
 * The panel is a native popover, which supplies the top layer, light dismiss,
 * Esc and `::backdrop`. `chrome.ts` drives `data-open` for the parts CSS
 * cannot reach, and stands in for the API on browsers that lack it.
 */
interface Props {
  page: PageKey;
}

const { page } = Astro.props;
const active = NAV_FOR_PAGE[page];
const current = NAV.find((item) => item.key === active)!;
---

<div
  class="group/nav mobile-nav fixed right-(--gutter) bottom-[calc(12px+env(safe-area-inset-bottom,0px))] z-40 nav:hidden"
>
  {
    /*
    `hidden` plus `open:block` rather than the UA's own display rule: without
    the Popover API there is no UA rule, and the panel would render open on
    arrival. `data-[open]` is the fallback's half of the same pair.
  */
  }
  <div
    id="navPanel"
    popover="auto"
    class="fixed inset-auto right-(--gutter) bottom-[calc(74px+env(safe-area-inset-bottom,0px))] m-0 hidden max-h-[min(70vh,32rem)] w-[min(17.5rem,calc(100vw_-_2*var(--gutter)))] origin-bottom-right translate-y-2 scale-95 overflow-y-auto rounded-card border border-line-strong bg-canvas p-2 opacity-0 transition-[opacity,transform,display,overlay] transition-discrete duration-300 ease-orbit backdrop:bg-ink/25 backdrop:opacity-0 backdrop:transition-opacity backdrop:duration-300 open:block open:translate-y-0 open:scale-100 open:opacity-100 open:backdrop:opacity-100 starting:open:translate-y-2 starting:open:scale-95 starting:open:opacity-0 data-[open]:block data-[open]:translate-y-0 data-[open]:scale-100 data-[open]:opacity-100 dark:backdrop:bg-black/50"
  >
    <nav class="grid gap-0.5" aria-label="Primary">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={item.key === active ? 'page' : undefined}
            class:list={[
              'flex min-h-11 items-center gap-3 rounded-md px-3 text-ui no-underline transition-colors duration-200 ease-orbit',
              item.key === active
                ? 'spectrum-fill font-semibold'
                : 'text-muted hover:text-ink',
            ]}
          >
            <Icon name={item.icon} class="size-[18px] shrink-0" />
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="mt-2 grid gap-2 border-t border-line pt-2">
      <Button
        href={`mailto:${EMAIL}`}
        size="sm"
        variant="primary"
        icon="lucide:mail"
        class="w-full justify-center">Email me</Button
      >
      <Button
        href={RESUME_HREF}
        size="sm"
        icon="lucide:file-down"
        class="w-full justify-center">Download resume</Button
      >
    </div>
  </div>

  {
    /*
    The visible section name stays inside the accessible name, so the two
    never disagree. `aria-label` would replace it and break that match.

    Scrolling down slides the control out rather than shrinking it. A shrunk
    node still sits over the text column at 390px, and a post is read for
    fifteen minutes: it covered a word of every screen on the way down.
    Only the button moves, never the wrapper -- a transformed ancestor is the
    one thing that can pull a top-layer popover out of the viewport.
  */
  }
  <button
    id="navBtn"
    type="button"
    popovertarget="navPanel"
    aria-expanded="false"
    class="flex h-12 cursor-pointer items-center gap-2.5 rounded-full border border-line-strong bg-canvas py-1.5 pr-4 pl-1.5 text-meta tracking-label text-ink uppercase transition-[translate,opacity,scale] duration-300 ease-orbit active:scale-[0.94] group-data-[collapsed]/nav:pointer-events-none group-data-[collapsed]/nav:translate-x-[calc(100%+var(--gutter))] group-data-[collapsed]/nav:opacity-0"
  >
    <span class="sr-only">Menu, current section: </span>
    <span
      class="grid size-9 shrink-0 place-items-center rounded-full spectrum-fill"
      aria-hidden="true"
    >
      <Icon name={current.icon} class="size-[18px]" />
    </span>
    <span>{current.label}</span>
    <Icon
      name="lucide:chevron-up"
      class="size-4 shrink-0 text-faint transition-[rotate] duration-300 ease-orbit group-data-[open]/nav:rotate-180"
    />
  </button>
</div>
