---
/**
 * The inline content of one Portable Text block, with its marks applied.
 *
 * A component rather than a helper because Astro frontmatter is TypeScript,
 * not JSX: markup cannot be returned from the script block, so anything that
 * renders has to be a component. Both paragraphs and list items need this, and
 * this is how they share it.
 */
interface Props {
  node: any;
}

const { node } = Astro.props;

/** A span's marks are either decorators (`strong`) or keys into `markDefs`. */
function marksFor(span: any, markDefs: any[] = []) {
  const defs = (span.marks ?? []).map(
    (mark: string) => markDefs.find((d) => d._key === mark) ?? mark
  );
  return {
    strong: defs.includes('strong'),
    em: defs.includes('em'),
    code: defs.includes('code'),
    link: defs.find((d: any) => d && d._type === 'link'),
  };
}

const spans = (node.children ?? []).map((span: any) => ({
  text: span.text,
  ...marksFor(span, node.markDefs),
}));
---

{
  spans.map((span: any) => {
    const inner = span.code ? <code>{span.text}</code> : span.text;
    const emphasised = span.em ? <em>{inner}</em> : inner;
    const bold = span.strong ? <strong>{emphasised}</strong> : emphasised;
    return span.link ? <a href={span.link.href}>{bold}</a> : bold;
  })
}
