---
import Heading2 from '@components/markdown/Heading2.astro';
import Heading3 from '@components/markdown/Heading3.astro';
import CaptionedImage from '@components/CaptionedImage.astro';
import Spans from '@components/Spans.astro';
import { imageUrl } from '@lib/sanity';

/**
 * Renders a Sanity Portable Text body using this site's own components.
 *
 * Portable Text is data rather than a compiled component, so it cannot go
 * through `render()` the way MDX does. That is the one real cost of moving
 * content out of the repo, and this file is where it is paid: every block type
 * is mapped to markup once, here, instead of being written inline in a post.
 *
 * The upside is that the mapping is central. A change to how images or code
 * blocks render moves every post at once.
 */
interface Props {
  value: any[];
}

const { value = [] } = Astro.props;

/** The plain text of a block, used for heading ids and their TOC entries. */
export function blockText(node: any) {
  return (node.children ?? []).map((c: any) => c.text ?? '').join('');
}

/**
 * The id a heading renders with, matching what rehype generates for MDX.
 *
 * Without these the table of contents links point at anchors that do not
 * exist, which breaks both jump-to-section and the scroll spy that highlights
 * the section currently in view.
 */
export function headingId(node: any) {
  return blockText(node)
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}

/**
 * Groups runs of consecutive list items into a single list.
 *
 * Portable Text marks each item individually rather than nesting them, so
 * rendering blocks one at a time puts every bullet in its own `<ul>` and the
 * gaps between them read as separate lists.
 */
function groupBlocks(nodes: any[]) {
  const out: any[] = [];
  for (const node of nodes) {
    const listType = node._type === 'block' ? node.listItem : undefined;
    const previous = out[out.length - 1];
    if (listType && previous?.list === listType) previous.items.push(node);
    else if (listType) out.push({ list: listType, items: [node] });
    else out.push(node);
  }
  return out;
}

const blocks = groupBlocks(value);
---

{
  blocks.map((node: any) => {
    if (node.list === 'bullet')
      return (
        <ul>
          {node.items.map((item: any) => (
            <li>
              <Spans node={item} />
            </li>
          ))}
        </ul>
      );

    if (node.list === 'number')
      return (
        <ol>
          {node.items.map((item: any) => (
            <li>
              <Spans node={item} />
            </li>
          ))}
        </ol>
      );

    if (node._type === 'image')
      return (
        <CaptionedImage
          src={imageUrl(node, { width: 1400 })}
          alt={node.alt}
          caption={node.caption}
          attribution={
            node.attribution?.href
              ? { src: node.attribution.href, text: node.attribution.text }
              : undefined
          }
        />
      );

    if (node._type === 'code')
      return (
        <pre>
          <code>{node.code}</code>
        </pre>
      );

    if (node._type !== 'block') return null;

    if (node.style === 'h2')
      return (
        <Heading2 id={headingId(node)}>
          <Spans node={node} />
        </Heading2>
      );

    if (node.style === 'h3')
      return (
        <Heading3 id={headingId(node)}>
          <Spans node={node} />
        </Heading3>
      );

    if (node.style === 'blockquote')
      return (
        <blockquote>
          <Spans node={node} />
        </blockquote>
      );

    return (
      <p>
        <Spans node={node} />
      </p>
    );
  })
}
