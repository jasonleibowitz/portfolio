---
import { groupId } from '../lib/lists';

/**
 * Section navigation for a grouped list.
 *
 * This slot used to hold a tag filter, which was the wrong control for the
 * page twice over. Only some entries carried tags, so it offered to narrow the
 * whole list and could only ever reach part of it; and every click hid whole
 * groups, so the one control on the page destroyed the structure that made the
 * page readable. Groups are the list's real index, so the rail navigates to
 * them instead of filtering them away -- which needs no JavaScript to work,
 * keeps every entry reachable, and leaves the back button meaningful.
 */
interface Props {
  groups: { name: string; items: unknown[] }[];
  heading?: string;
}

const { groups, heading = 'Sections' } = Astro.props;
---

{
  /*
  Rendered before the list in the DOM and moved right by `order` on desktop, so
  a keyboard user reaches the section nav before the sections rather than after
  every entry in them.
*/
}
<aside class="rail:order-last rail:sticky rail:top-[88px]" data-group-nav>
  <h2
    class="mb-3 font-mono text-meta font-normal tracking-[0.16em] text-faint uppercase"
  >
    {heading}
  </h2>

  {
    /*
    A flex row of chips in an auto-sized grid track sizes to max-content and
    pushes the whole page ~400px wide at 320px. The grid parent constrains the
    track; `overflow-x-auto` lets the row scroll inside it.
  */
  }
  <nav
    aria-label={heading}
    class="flex gap-2 overflow-x-auto pb-2 rail:flex-col rail:overflow-visible"
  >
    {
      groups.map((group) => (
        <a href={`#${groupId(group.name)}`} class="group-link">
          {group.name} <b>{group.items.length}</b>
        </a>
      ))
    }
  </nav>
</aside>

<style>
  .group-link {
    font: inherit;
    font-size: var(--text-ui);
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-height: 44px;
    padding-inline: 14px;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background: var(--color-panel);
    color: var(--color-muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .group-link:hover {
    color: var(--color-ink);
    border-color: var(--color-line-strong);
  }
  .group-link b {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-weight: 400;
    color: var(--color-faint);
  }

  /* Set by the scroll spy in chrome.ts on whichever group is in view. The
     gradient is the system's active-state mark, and here it means the same
     thing it means in the nav: this is where you are. */
  .group-link[aria-current='true'] {
    background: linear-gradient(100deg, var(--color-violet), var(--color-cyan));
    border-color: transparent;
    color: #fff;
  }
  .group-link[aria-current='true'] b {
    color: rgb(255 255 255 / 0.85);
  }
</style>
