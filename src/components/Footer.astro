---
const socialLinks = [
  {
    url: 'https://github.com/jasonleibowitz',
    src: '/icons/github-black.svg',
    label: 'GitHub',
  },
  {
    url: 'https://www.linkedin.com/in/jasonleibowitz/',
    src: '/icons/linkedin-black.svg',
    label: 'LinkedIn',
  },
  {
    url: 'https://twitter.com/jasonleibowitz',
    src: '/icons/twitter-black.svg',
    label: 'Twitter',
  },
];
---

<footer class="mt-auto bg-linear-to-r from-purple-700 to-blue-600 h-40 p-8">
  <div class="text-white">
    <h3 class="text-2xl">Jason Leibowitz</h3>
    <div class="flex pt-4">
      {
        socialLinks.map(({ url, src, label }) => (
          <a href={url} target="_blank" rel="noreferrer noopener">
            <img class="h-10 w-10" src={src} alt={label} />
          </a>
        ))
      }
    </div>
  </div>
</footer>
