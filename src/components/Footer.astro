---
import Shell from './ui/Shell.astro';
import SocialRow from './SocialRow.astro';
import Button from './ui/Button.astro';
import { EMAIL, NAV, RESUME_HREF } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-line py-(--section)">
  <Shell class="grid gap-6">
    <div class="grid gap-4">
      <p class="max-w-[16ch] font-display text-h2 font-bold tracking-[-0.03em]">
        Let's build <span class="text-gradient">something</span>.
      </p>

      <div class="flex flex-wrap gap-2">
        <Button
          href={`mailto:${EMAIL}`}
          size="sm"
          variant="primary"
          icon="lucide:mail">Email me</Button
        >
        <Button href={RESUME_HREF} size="sm" icon="lucide:file-down"
          >Download resume</Button
        >
      </div>
    </div>

    {
      /*
      Centered as a block on mobile, spread on wider screens. The nav is five
      short links, so a wrapping row beats a two-column grid — that left an
      orphan cell opposite the fifth item.
    */
    }
    <div
      class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 sm:justify-between"
    >
      <div class="flex flex-wrap justify-center gap-x-6 sm:justify-start">
        {
          NAV.map((item) => (
            <a
              href={item.href}
              class="inline-flex min-h-11 items-center text-ui text-muted no-underline hover:text-violet"
            >
              {item.label}
            </a>
          ))
        }
      </div>

      {/* Complete, rather than an arbitrary two of four. */}
      <SocialRow class="justify-center sm:-ml-2.5 sm:justify-start" />

      <p
        class="text-center font-mono text-meta tracking-[0.06em] whitespace-nowrap text-faint sm:text-right"
      >
        © {year} · Made with ❤️ in NYC
      </p>
    </div>
  </Shell>
</footer>
