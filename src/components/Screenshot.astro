---
/* Only TypeScript sees `ImageMetadata` as a global. Import it, or eslint
   reads it as undefined. */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import DeviceBody from './DeviceBody.astro';

/**
 * One real capture, on the screen of a device.
 *
 * A screen holds both themes, and the pair swaps on `data-theme` rather than
 * fusing into one diagonal image. A fused image is what a store listing needs,
 * where nothing can know the reader; this page does know, thus each theme gets
 * a capture taken in it.
 */
interface Props {
  shot: {
    light: ImageMetadata;
    dark?: ImageMetadata;
    alt: string;
  };
  kind?: 'phone' | 'window';
  size?: 'default' | 'wide' | 'shot';
  class?: string;
}

const {
  shot,
  kind = 'phone',
  size = 'default',
  class: className,
} = Astro.props;

const radius =
  kind === 'phone'
    ? 'rounded-[calc(var(--shot-w)*0.120)]'
    : 'rounded-[calc(var(--shot-w)*0.028)]';
const shared = `block w-full ${radius}`;

/*
 * Both files ship, and both say `eager`, which `<Image>` needs told: it lazies
 * by default, and a lazy image that starts `display: none` is never fetched.
 * Showing it does not reliably start the fetch either, thus the first toggle
 * drew empty frames for every screen the reader had not already seen. The
 * theme can change at any moment after load, so the pair is one unit: both
 * load, or the swap has nothing to swap to.
 *
 * Both carry the same `alt`, and neither is hidden by hand. `display: none`
 * already takes the one that is not shown out of the accessibility tree, thus
 * exactly one is read. Marking the second `aria-hidden` instead leaves dark
 * mode announcing nothing at all.
 */
---

<DeviceBody kind={kind} size={size} class={className}>
  <Image
    src={shot.light}
    alt={shot.alt}
    width={400}
    densities={[1, 2]}
    loading="eager"
    class:list={[shared, shot.dark && 'dark:hidden']}
  />

  {
    shot.dark && (
      <Image
        src={shot.dark}
        alt={shot.alt}
        width={400}
        densities={[1, 2]}
        loading="eager"
        class:list={[shared, 'hidden dark:block']}
      />
    )
  }
</DeviceBody>
