---
/* Only TypeScript sees `ImageMetadata` as a global. Import it, or eslint
   reads it as undefined. */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import DeviceBody from './DeviceBody.astro';

/**
 * One real capture, on the screen of a device.
 *
 * A screen holds both themes and the pair swaps on `data-theme`, rather than
 * fusing into one diagonal image. A fused image is for a store listing, where
 * nothing can know the reader. This page does.
 */
interface Props {
  shot: {
    light: ImageMetadata;
    dark?: ImageMetadata;
    alt: string;
    caption?: string;
  };
  kind?: 'phone' | 'window';
  size?: 'default' | 'wide' | 'shot' | 'mixed';
  class?: string;
  /**
   * Mark the frame so `lightbox.ts` can make it a control that opens the
   * matching slide. Opt-in and never automatic: on `/projects` a `Screenshot`
   * sits inside the anchor that makes the whole row a link, and a button
   * nested in a link is neither valid nor clickable.
   */
  lightbox?: boolean;
}

/**
 * The widest each slot is ever drawn, in CSS pixels. `densities` doubles it
 * for a retina screen, so one number here decides whether a capture is sharp.
 * One figure for every slot is what made the browser shots mush: 400 covered
 * a 280px phone twice over and left a 640px window upscaling.
 */
const INTRINSIC = {
  phone: { default: 150, wide: 210, shot: 290, mixed: 220 },
  window: { default: 250, wide: 290, shot: 650, mixed: 650 },
} as const;

const {
  shot,
  kind = 'phone',
  size = 'default',
  class: className,
  lightbox = false,
} = Astro.props;

/* A capture of a browser already holds its own window: chrome, corners and
   shadow are in the picture, so it gets width and nothing else. A capture of
   an app holds only the screen, so the site draws the phone. */
const bare = kind === 'window';
const radius = bare ? '' : 'rounded-[calc(var(--shot-w)*0.120)]';
const shared = `block w-full ${radius}`;

/**
 * What both renditions share.
 *
 * `eager` has to be said: `<Image>` lazies by default, a lazy image that
 * starts `display: none` is never fetched, and showing it later does not
 * reliably start the fetch. The theme can change at any moment, so the pair is
 * one unit -- both load, or the swap has nothing to swap to. Both carry the
 * same `alt`, because `display: none` already takes the hidden one out of the
 * accessibility tree and exactly one is read.
 */
const pair = {
  alt: shot.alt,
  width: INTRINSIC[kind][size],
  densities: [1, 2],
  loading: 'eager' as const,
};
---

<DeviceBody
  kind={kind}
  size={size}
  bare={bare}
  class={className}
  {...lightbox ? { 'data-shot': '' } : {}}
>
  <Image
    src={shot.light}
    {...pair}
    class:list={[shared, shot.dark && 'dark:hidden']}
  />

  {
    shot.dark && (
      <Image
        src={shot.dark}
        {...pair}
        class:list={[shared, 'hidden dark:block']}
      />
    )
  }
</DeviceBody>
