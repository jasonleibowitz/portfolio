---
import type { CollectionEntry } from 'astro:content';
import Status from './ui/Status.astro';
import Chip from './ui/Chip.astro';
import Ph from './ui/Ph.astro';
import DeviceFrame from './DeviceFrame.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Full-width on /projects, two-up on the homepage. */
  wide?: boolean;
}

const { project, wide = false } = Astro.props;
const { data } = project;
---

{
  /* Named by the project alone. Without it the accessible name is the whole
    card read as one run-on -- status, title, description, every stack chip and
    the arrow -- which is what a screen-reader user hears for each card in a
    list of them. `ProjectRow` carries the same pair for the same reason. */
}
<a
  href={`/projects/${project.id}/`}
  aria-label={data.title}
  class="group relative flex flex-col overflow-hidden rounded-card border border-line bg-panel p-6 no-underline transition-[transform,box-shadow] duration-200 ease-[cubic-bezier(0.2,0.8,0.2,1)] hover:-translate-y-[3px] hover:border-line-strong hover:shadow-lift"
>
  {
    /* `border-color` is deliberately absent from the transition above. A
      transition on a property whose value comes from a custom property freezes
      at the old value when the theme swaps the token, so the card kept its
      light border in dark mode — 1.00:1, invisible. The hover step is a
      0.09→0.16 alpha change that does not need to animate anyway.

      `items-center` splits the leftover height either side of the copy instead
      of pooling it all underneath a frame twice the copy's height, and
      `justify-center` only bites on a line with free space — which is the line
      the frame sits on alone once the card is too narrow to hold both. */
  }
  <div class="flex flex-wrap items-center justify-center gap-6">
    <DeviceFrame kind={data.frame} size={wide ? 'wide' : 'default'} />

    {
      /* A full-width card has room for a wider copy column; a half-width one
        would wrap the frame onto its own line if it claimed the same. */
    }
    <div
      class:list={[
        'flex min-w-0 flex-1 basis-[200px] flex-col gap-3',
        wide && 'card:basis-[320px]',
      ]}
    >
      <Status pulse={data.status_pulse}>{data.status_text}</Status>

      <h3 class="font-display text-h3 font-bold tracking-[-0.028em]">
        {data.title}
      </h3>

      <Ph
        as="p"
        when={data.placeholder.includes('description')}
        class="text-ui text-muted"
      >
        {data.description}
      </Ph>

      <div class="flex flex-wrap gap-1.5">
        {data.stack.map((tool) => <Chip>{tool}</Chip>)}
      </div>

      {
        wide && (
          <span
            class="inline-flex min-h-11 items-center text-ui whitespace-nowrap text-muted card:ml-auto group-hover:text-violet"
            aria-hidden="true"
          >
            Read more →
          </span>
        )
      }
    </div>
  </div>
</a>
