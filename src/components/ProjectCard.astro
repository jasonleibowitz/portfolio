---
import type { CollectionEntry } from 'astro:content';
import Status from './ui/Status.astro';
import Chip from './ui/Chip.astro';
import Ph from './ui/Ph.astro';
import DeviceFrame from './DeviceFrame.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Full-width on /projects, two-up on the homepage. */
  wide?: boolean;
}

const { project, wide = false } = Astro.props;
const { data } = project;
---

<a
  href={`/projects/${project.id}/`}
  class="group relative flex flex-col gap-4 overflow-hidden rounded-card border border-line bg-panel p-6 no-underline transition-[transform,box-shadow,border-color] duration-200 ease-[cubic-bezier(0.2,0.8,0.2,1)] hover:-translate-y-[3px] hover:border-line-strong hover:shadow-lift"
>
  <div class="flex flex-wrap items-start gap-6">
    <DeviceFrame kind={data.frame} size={wide ? 'wide' : 'default'} />

    {
      /* A full-width card has room for a wider copy column; a half-width one
        would wrap the frame onto its own line if it claimed the same. */
    }
    <div
      class:list={[
        'flex min-w-0 flex-1 basis-[200px] flex-col gap-3',
        wide && 'card:basis-[320px]',
      ]}
    >
      <Status pulse={data.status_pulse}>{data.status_text}</Status>

      <h3 class="font-display text-h3 font-bold tracking-[-0.028em]">
        {data.title}
      </h3>

      <Ph
        as="p"
        when={data.placeholder.includes('description')}
        class="text-ui text-muted"
      >
        {data.description}
      </Ph>

      <div class="mt-auto flex flex-wrap gap-1.5">
        {data.stack.map((tool) => <Chip>{tool}</Chip>)}
      </div>

      {
        wide && (
          <span class="inline-flex min-h-11 items-center text-ui whitespace-nowrap text-muted card:ml-auto group-hover:text-violet">
            Read the case study →
          </span>
        )
      }
    </div>
  </div>
</a>
