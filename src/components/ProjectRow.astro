---
import type { CollectionEntry } from 'astro:content';
import Status from './ui/Status.astro';
import Chip from './ui/Chip.astro';
import DeviceFrame from './DeviceFrame.astro';
import { projectHref } from '@lib/content';
import Typography from './ui/Typography.astro';

/** One project on `/projects`, as a full-width editorial row. */
interface Props {
  project: CollectionEntry<'projects'>;
  /**
   * Position in the list. Drives the alternation and the frame variant, so
   * neither depends on the optional `order` field.
   */
  index: number;
}

const { project, index } = Astro.props;
const { data } = project;

// Art alternates sides. The frames cycle so three in a column do not repeat.
const flip = index % 2 === 1;
const variant = (index % 3) as 0 | 1 | 2;

// A browser window is landscape, so it takes a wider slot than a phone.
const isWindow = data.frame === 'window';
---

<a
  href={projectHref(project)}
  aria-label={data.title}
  class="group block border-t border-line py-10 no-underline"
>
  <div
    class:list={[
      'flex flex-col gap-6 card:flex-row card:items-center card:gap-10',
      flip && 'card:flex-row-reverse',
    ]}
  >
    {
      /* Stacked, the art is a fixed-width object in a full-width column, so
        center it. */
    }
    <div
      class:list={[
        'mx-auto shrink-0 card:mx-0',
        isWindow ? 'w-[240px] card:w-[300px]' : 'w-[140px] card:w-[190px]',
      ]}
    >
      <DeviceFrame
        kind={data.frame}
        variant={variant}
        class="max-w-none transition-transform duration-300 ease-orbit group-hover:-translate-y-1"
      />
    </div>

    <div class="flex min-w-0 flex-1 flex-col gap-3">
      <Status status={data.status}>{data.status_text}</Status>

      {/* The page h1 is the masthead, and a row is its first subsection. */}
      <Typography variant="heading2">
        {data.title}
      </Typography>

      <Typography as="p" variant="body" class="max-w-[46ch] text-muted">
        {data.description}
      </Typography>

      <div class="mt-1 flex flex-wrap gap-1.5">
        {data.stack.map((tool) => <Chip>{tool}</Chip>)}
      </div>

      {
        /* The whole row is the link, so this is decoration. `aria-hidden` keeps
          it out of every project's accessible name. */
      }
      <Typography
        variant="compact"
        as="span"
        class="mt-2 inline-flex min-h-11 items-center text-muted group-hover:text-violet"
        aria-hidden="true"
      >
        Read more&nbsp;→
      </Typography>
    </div>
  </div>
</a>
