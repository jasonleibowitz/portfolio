---
import type { CollectionEntry } from 'astro:content';
import Status from './ui/Status.astro';
import Chip from './ui/Chip.astro';
import Ph from './ui/Ph.astro';
import DeviceFrame from './DeviceFrame.astro';
import Typography from './ui/Typography.astro';

/**
 * One project on `/projects`, as a full-width editorial row.
 *
 * There is deliberately no card here. A bordered box advertises its own edges,
 * so any space left inside it reads as unfilled — and a phone screenshot is
 * roughly twice the height the copy beside it will ever reach. Bounding the
 * row with a single hairline instead lets the art stand at its real height
 * without framing the space next to it, and centering the copy against the art
 * splits the remainder evenly rather than pooling it all underneath.
 *
 * The homepage runs the same argument to its conclusion in `ProjectBrief`:
 * two-up on half a shell leaves no room for art beside the copy, so it drops
 * the frame entirely and spends the space on the spec facts instead.
 */
interface Props {
  project: CollectionEntry<'projects'>;
  /** Position in the list. Drives both the alternation and the frame's
   * composition, so neither depends on the optional `order` field. */
  index: number;
}

const { project, index } = Astro.props;
const { data } = project;

// Art alternates sides; the drawn frames cycle so three in a column don't read
// as the same image repeated.
const flip = index % 2 === 1;
const variant = (index % 3) as 0 | 1 | 2;

// A browser window is landscape; squeezed into the phone's portrait slot it
// renders barely taller than its own title bar.
const isWindow = data.frame === 'window';
---

<a
  href={`/projects/${project.id}/`}
  aria-label={data.title}
  class="group block border-t border-line py-10 no-underline"
>
  <div
    class:list={[
      'flex flex-col gap-6 card:flex-row card:items-center card:gap-10',
      flip && 'card:flex-row-reverse',
    ]}
  >
    {
      /* Stacked, the art is a fixed-width object in a full-width column, so it
        sits hard left with the leftover space beside it. Centering it is what
        makes the stack read as composed rather than as a row that failed. */
    }
    <div
      class:list={[
        'mx-auto shrink-0 card:mx-0',
        isWindow ? 'w-[240px] card:w-[300px]' : 'w-[140px] card:w-[190px]',
      ]}
    >
      <DeviceFrame
        kind={data.frame}
        variant={variant}
        class="max-w-none transition-transform duration-300 ease-[cubic-bezier(0.2,0.8,0.2,1)] group-hover:-translate-y-1"
      />
    </div>

    <div class="flex min-w-0 flex-1 flex-col gap-3">
      <Status status={data.status}>{data.status_text}</Status>

      {
        /* h2: the page's h1 is the masthead, and a row is its first subsection.
        An h3 here left the heading outline with a hole in it. */
      }
      <Typography variant="heading2">
        {data.title}
      </Typography>

      <Ph
        as="p"
        when={data.placeholder.includes('description')}
        variant="body"
        class="max-w-[46ch] text-muted"
      >
        {data.description}
      </Ph>

      <div class="mt-1 flex flex-wrap gap-1.5">
        {data.stack.map((tool) => <Chip>{tool}</Chip>)}
      </div>

      {
        /* The whole row is the link, so this is a visual affordance only —
          announcing it would append it to every project's accessible name. */
      }
      <Typography
        variant="compact"
        as="span"
        class="mt-2 inline-flex min-h-11 items-center text-muted group-hover:text-violet"
        aria-hidden="true"
      >
        Read more&nbsp;→
      </Typography>
    </div>
  </div>
</a>
