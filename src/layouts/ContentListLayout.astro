---
import BaseLayout from '@layouts/BaseLayout.astro';
import BlogPost from '@components/BlogPost.astro';
import type { PublishableEntry } from '../lib/content';

interface Props {
  pageTitle: string;
  items: PublishableEntry[];
  baseUrl: string;
}

const { pageTitle, items, baseUrl } = Astro.props;
---

<BaseLayout pageTitle={pageTitle}>
  <div class="max-w-4xl mx-auto mt-20 mb-0">
    <h1>{pageTitle}</h1>
    <article class="mx-auto my-0">
      <ul class="mt-8">
        {
          items.map((item) => (
            <BlogPost
              url={`${baseUrl}/${item.id}/`}
              title={item.data.title}
              pubDate={item.data.pubDate}
              tags={'tags' in item.data ? item.data.tags : undefined}
            />
          ))
        }
      </ul>
    </article>
  </div>
</BaseLayout>
