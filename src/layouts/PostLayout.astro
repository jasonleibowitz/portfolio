---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { formatDay, isoDay } from '@lib/dates';
import BaseLayout from './BaseLayout.astro';
import Section from '@components/layout/Section.astro';
import Typography from '@components/ui/Typography.astro';
import Toc from '@components/Toc.astro';
import { readingMinutes, wordCount } from '@lib/reading';
import Link from '@components/ui/Link.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: MarkdownHeading[];
  next?: CollectionEntry<'blog'>;
}

const { post, headings, next } = Astro.props;
const { title, pubDate, description, tags, image } = post.data;

const minutes = readingMinutes(post.body);
const words = wordCount(post.body);
---

<BaseLayout pageTitle={title} page="post" description={description}>
  <Section as="article" flush={false}>
    {/* One centered column at a 46rem measure — 40rem read too narrow. */}
    <header class="mx-auto max-w-measure">
      <Typography variant="caption">Writing</Typography>
      <Typography variant="heading1" class="mt-3 mb-4 leading-[1.04]">
        {title}
      </Typography>

      {/* Promoted from small print at the bottom to chips under the title. */}
      <div class="mb-4 flex flex-wrap gap-2">
        {
          tags.map((tag) => (
            <Link
              variant="data"
              class="text-muted hover:text-violet rounded-full border border-line bg-panel px-3.5 before:opacity-55 before:content-['#'] hover:border-violet hover:text-ink"
              href={`/writing/tags/${tag}/`}
            >
              {tag}
            </Link>
          ))
        }
      </div>

      <Typography
        variant="caption"
        as="div"
        class="flex flex-wrap gap-4 border-b border-line pb-6"
      >
        <time datetime={isoDay(pubDate)}>{formatDay(pubDate)}</time>
        <span>{minutes} min read</span>
        <span>{words.toLocaleString('en-US')} words</span>
      </Typography>
    </header>

    <div class="mx-auto max-w-measure">
      <Toc headings={headings} />

      {
        image?.url && (
          <figure class="my-12">
            <img
              src={image.url}
              alt={image.alt}
              class="aspect-video w-full rounded-card object-cover shadow-lift"
              loading="eager"
            />
          </figure>
        )
      }

      <Typography variant="longform" class="markdown"><slot /></Typography>

      <Typography
        variant="compact"
        as="div"
        class="mt-12 flex flex-wrap justify-between gap-4 border-t border-line pt-6 text-muted"
      >
        <span>Filed under {tags.join(' · ')}</span>
        {
          next && (
            <span>
              Next:{' '}
              <a
                href={`/writing/${next.id}/`}
                class="inline-flex min-h-11 items-center text-ink no-underline hover:text-violet"
              >
                {next.data.title}
              </a>
            </span>
          )
        }
      </Typography>
    </div>
  </Section>
</BaseLayout>

<script>
  import { initFootnotes } from '@lib/footnotes';

  initFootnotes();
</script>
