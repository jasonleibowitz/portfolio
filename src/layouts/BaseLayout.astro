---
import Aurora from '@components/Aurora.astro';
import Header from '@components/Header.astro';
import MobileNav from '@components/MobileNav.astro';
import Footer from '@components/Footer.astro';
import { FEED_TITLE, type PageKey } from '@lib/site';
import { shareCard } from '@lib/og';

import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/inter';
import '@fontsource/jetbrains-mono';
import '@styles/global.css';

interface Props {
  pageTitle: string;
  description?: string;
  /** Drives the active nav state and the reading-progress bar. */
  page: PageKey;
  /**
   * The image of the share card. A page that has its own image gives it here.
   * A page with no image gets the default card. Thus a link always has an
   * image: without one, iMessage shows a line of text only.
   */
  image?: string;
  imageAlt?: string;
  /**
   * A square image is an app icon. A card of 1.91:1 removes the top and the
   * bottom of a square image, thus such a page asks for the small card.
   */
  imageShape?: 'wide' | 'square';
}

const {
  pageTitle,
  description,
  page,
  image,
  imageAlt,
  imageShape = 'wide',
} = Astro.props;

/**
 * The homepage states a role where the interior pages state a section.
 *
 * A bare name is the convention for a personal site, but it assumes the name
 * is already unambiguous. A search for this one returns a page of Miami ENT
 * surgeons, so the title has to say which Jason Leibowitz this is, and the
 * city separates him from the other doctor as well. This restates the hero's
 * eyebrow in prose deliberately: the two are the same claim, and a searcher
 * scanning results reads this one before any of the page.
 */
const HOME_TITLE = 'Jason Leibowitz · Full-stack engineer in New York';

const isHome = pageTitle === 'Home';
const title = isHome ? HOME_TITLE : `${pageTitle} · Jason Leibowitz`;
const showProgress = page === 'post' || page === 'project';

const canonical = new URL(Astro.url.pathname, Astro.site);

/**
 * The alternative text of the default card. That card shows the orbit avatar,
 * the name and the role, thus this text says the same.
 */
const DEFAULT_SHARE_ALT = 'Jason Leibowitz, full-stack engineer in New York';

/* Absolute, because every scraper resolves these against its own host and not
   against the page. A project's icon is already a built asset path, which
   `URL` leaves alone. */
const share = new URL(image ?? shareCard('default'), Astro.site).href;
const shareAlt = image ? imageAlt : DEFAULT_SHARE_ALT;

/* The card's headline drops the site suffix that `<title>` carries, since
   `og:site_name` is already saying it one line below. The homepage keeps its
   full title: without the role it would repeat `og:site_name` word for word. */
const shareTitle = isHome ? HOME_TITLE : pageTitle;
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      /* The mark again, as a square image. A link preview of Apple and the
        home screen of iOS do not read an SVG favicon. iOS makes the corners
        round, thus the corners of this image are square. */
    }
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={FEED_TITLE}
      href="/rss.xml"
    />
    <link rel="canonical" href={canonical} />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>

    {
      /*
      Visitors mostly arrive from somewhere else, so the card a link renders as
      is a real entry surface rather than a nicety. X reads the `og:` tags when
      it has no `twitter:` twin, so only the two it has no equivalent for are
      spelled out here; a second copy of the title is a second thing to drift.
    */
    }
    <meta
      property="og:type"
      content={page === 'post' ? 'article' : 'website'}
    />
    <meta property="og:site_name" content="Jason Leibowitz" />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:url" content={canonical} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={share} />
    {shareAlt && <meta property="og:image:alt" content={shareAlt} />}
    <meta
      name="twitter:card"
      content={imageShape === 'square' ? 'summary' : 'summary_large_image'}
    />
    <meta name="twitter:creator" content="@jasonleibowitz" />
    {
      /*
      Blocking on purpose. Every page of a static site is a fresh document, so
      deferring this flashes white on each navigation.

      Storage is read only for an override; with none, the device decides --
      including when storage throws.
    */
    }
    <script is:inline>
      (function () {
        let saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch {
          /* private mode, or storage blocked */
        }
        document.documentElement.dataset.theme =
          saved === 'dark' || saved === 'light'
            ? saved
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
      })();
    </script>
  </head>

  {
    /* The nav control floats over the end of the page, so the body reserves
       its height. */
  }
  <body
    class="flex min-h-screen flex-col pb-[calc(72px+env(safe-area-inset-bottom,0px))] nav:pb-0"
    data-page={page}
  >
    <Aurora />
    <a
      href="#main"
      class="absolute -left-[9999px] z-60 bg-ink px-4 py-3 text-canvas focus:top-4 focus:left-4"
      >Skip to content</a
    >

    <Header page={page} progress={showProgress} />
    <main id="main" class="flex-1"><slot /></main>
    <Footer />
    <MobileNav page={page} />
  </body>
</html>

<script>
  import { initChrome } from '@lib/chrome';

  initChrome();
</script>
