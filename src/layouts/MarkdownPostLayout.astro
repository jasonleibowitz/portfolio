---
import TagList from '@components/TagList.astro';
import BaseLayout from './BaseLayout.astro';
import { format } from 'date-fns';

interface Props {
  frontmatter: {
    title: string;
    pubDate: Date;
    description?: string;
    tags?: string[];
    image?: { url: string; alt: string };
  };
  readingTime: { text: string };
}

const { frontmatter, readingTime } = Astro.props;
---

<BaseLayout pageTitle={frontmatter.title} description={frontmatter.description}>
  <div
    class="prose prose-base lg:prose-lg dark:prose-invert prose-h1:my-4 prose-h2:my-3 lg:prose-h1:text-4xl lg:prose-h2:my-3 lg:prose-h2:text-3xl mx-auto my-10"
  >
    <h1 class="text-center">{frontmatter.title}</h1>
    <div class="text-base">
      <span class="font-bold">
        <time datetime={frontmatter.pubDate.toISOString()}>
          {format(frontmatter.pubDate, 'MMMM d, yyyy')}
        </time>
      </span>
      <span
        class="mx-4 p-4 border-l-2 border-gray-300 text-gray-500 font-normal"
        >{readingTime.text}</span
      >
    </div>
    <TagList baseUrl="/blog/tags" tags={frontmatter.tags} />
    {
      frontmatter.image?.url && (
        <img
          class="mx-auto my-0"
          src={frontmatter.image.url}
          width="600"
          alt={frontmatter.image.alt}
        />
      )
    }
    <slot />
  </div>
</BaseLayout>
