---
import ContentListLayout from '@layouts/ContentListLayout.astro';
import { getPublished, getPublishedTags } from '../../../lib/content';

export async function getStaticPaths() {
  const posts = await getPublished('blog');
  const tags = await getPublishedTags();

  return tags.map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<ContentListLayout
  pageTitle={`Blog Posts tagged with ${tag}`}
  items={posts}
  baseUrl="/blog"
/>
