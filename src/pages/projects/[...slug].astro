---
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/layout/Section.astro';
import Typography from '@components/ui/Typography.astro';
import Heading2 from '@components/markdown/Heading2.astro';
import Heading3 from '@components/markdown/Heading3.astro';
import TextLink from '@components/markdown/TextLink.astro';
import FactBox from '@components/ui/FactBox.astro';
import Fact from '@components/ui/Fact.astro';
import Status from '@components/ui/Status.astro';
import Button from '@components/ui/Button.astro';
import DeviceFrame from '@components/DeviceFrame.astro';
import Screenshot from '@components/Screenshot.astro';
import { getPublished } from '@lib/content';
import { testflightRequestHref } from '@lib/site';

export async function getStaticPaths() {
  const projects = await getPublished('projects');

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

/**
 * The share card is the icon of the app, in the PNG format. The icons are webp
 * files, which the page uses and which iMessage reads, but the crawler of
 * LinkedIn does not read a webp file and shows no image. A project with no icon
 * gets the default card of the site.
 */
const shareIcon = data.icon
  ? await getImage({ src: data.icon, format: 'png' })
  : undefined;

/** The beta invite first, because it is the one that asks for a reply. */
const ctas = [
  data.testflight && {
    label: 'Join the beta',
    href: testflightRequestHref(data.title),
    icon: 'lucide:mail',
  },
  data.cta && { ...data.cta, icon: undefined },
].filter((cta) => cta !== false && cta != null);
---

<BaseLayout
  pageTitle={data.title}
  page="project"
  description={data.description}
  image={shareIcon?.src}
  imageAlt={shareIcon && `The ${data.title} app icon`}
  imageShape={shareIcon ? 'square' : 'wide'}
  imageWidth={data.icon?.width}
  imageHeight={data.icon?.height}
>
  <Section flush={false}>
    <Status status={data.status}>
      {data.status_text_long ?? data.status_text}
    </Status>
    <Typography variant="heading1" class="my-3">
      {data.title}
    </Typography>
    <Typography as="p" variant="intro" class="max-w-[56ch] text-muted">
      {data.description}
    </Typography>
  </Section>

  <Section>
    {
      /* Three grid children rather than two, so the rail can sit between the
        screenshots and the write-up once the columns collapse. Stacked, the
        stats read as a caption to the shots; deferred to the bottom they were
        below a page of prose nobody had scrolled yet. */
    }
    <div
      class="grid gap-8 spec:grid-cols-[minmax(0,1fr)_268px] spec:items-start spec:gap-x-16 [&>*]:min-w-0"
    >
      {
        /* The captures are wider than the column on purpose, so a screen is big
        enough to read rather than big enough to identify. That makes the row a
        scroller, thus it takes a tabindex: a region that scrolls and holds no
        link of its own is unreachable by keyboard without one. */
      }
      <div
        class="flex snap-x snap-mandatory gap-6 overflow-x-auto pt-2 pb-6 spec:col-start-1 spec:row-start-1 [scrollbar-width:thin]"
        tabindex="0"
        role="group"
        aria-label={`${data.title} screenshots`}
      >
        {
          data.screenshots.length > 0
            ? data.screenshots.map((shot) => (
                <Screenshot shot={shot} kind={data.frame} size="shot" />
              ))
            : [0, 1, 2].map((variant) => (
                <DeviceFrame
                  kind={data.frame}
                  size="shot"
                  variant={variant as 0 | 1 | 2}
                />
              ))
        }
      </div>

      <aside
        class="spec:sticky spec:top-header spec:col-start-2 spec:row-start-1 spec:row-end-3"
      >
        <FactBox>
          {
            data.specs.map((spec) => (
              <Fact label={spec.label} narrow>
                {spec.value}
              </Fact>
            ))
          }
        </FactBox>

        {
          ctas.length > 0 && (
            <div class="mt-4 flex flex-wrap justify-center gap-2">
              {ctas.map((cta) => (
                <Button href={cta.href} variant="primary" icon={cta.icon}>
                  {cta.label}
                </Button>
              ))}
            </div>
          )
        }
      </aside>

      <div class="spec:col-start-1 spec:row-start-2">
        <Typography variant="longform" class="markdown max-w-measure">
          <Content components={{ h2: Heading2, h3: Heading3, a: TextLink }} />
        </Typography>
      </div>
    </div>
  </Section>
</BaseLayout>
