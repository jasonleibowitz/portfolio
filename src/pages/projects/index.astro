---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHead from '@components/ui/PageHead.astro';
import Section from '@components/layout/Section.astro';
import ProjectRow from '@components/ProjectRow.astro';
import { getPublished } from '../../lib/content';

const projects = await getPublished('projects');
---

<BaseLayout
  pageTitle="Projects"
  page="projects"
  description="Two mobile apps in TestFlight, plus the site you're reading."
>
  <PageHead
    eyebrow="Side projects"
    title="Things I'm building"
    lead="Two mobile apps in TestFlight, plus the site you're reading. Each has a write-up: what it does, why it exists, and what I'd do differently."
  />

  <Section>
    {
      /* Hairline-separated rows rather than cards, alternating which side
        the art sits on. Each row draws its own top rule and the footer draws
        the page's closing one, so a bottom rule here would land a second
        hairline barely a section's padding above the footer's. */
    }
    {projects.map((project, i) => <ProjectRow project={project} index={i} />)}
  </Section>
</BaseLayout>
