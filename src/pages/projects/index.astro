---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHead from '@components/ui/PageHead.astro';
import Section from '@components/layout/Section.astro';
import ProjectRow from '@components/ProjectRow.astro';
import { getPublished } from '@lib/content';

const projects = await getPublished('projects');
---

<BaseLayout
  pageTitle="Projects"
  page="projects"
  description="List of side projects I've built"
>
  <PageHead
    eyebrow="Side projects"
    title="Things I'm building"
    intro="I enjoy working on side projects that let me explore new ideas, learn new technologies, and build products that people enjoy using. Here are a few of the things I've built."
  />

  <Section>
    {
      /* Hairline-separated rows rather than cards, alternating which side
        the art sits on. Each row draws its own top rule and the footer draws
        the page's closing one, so a bottom rule here would land a second
        hairline barely a section's padding above the footer's. */
    }
    {projects.map((project, i) => <ProjectRow project={project} index={i} />)}
  </Section>
</BaseLayout>
