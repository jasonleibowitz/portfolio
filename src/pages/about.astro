---
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHead from '@components/ui/PageHead.astro';
import Shell from '@components/ui/Shell.astro';
import Section from '@components/ui/Section.astro';
import SectionHead from '@components/ui/SectionHead.astro';
import Panel from '@components/ui/Panel.astro';
import Button from '@components/ui/Button.astro';
import Chip from '@components/ui/Chip.astro';
import Ph from '@components/ui/Ph.astro';
import PhNote from '@components/ui/PhNote.astro';
import Timeline from '@components/Timeline.astro';
import { EMAIL, RESUME_HREF } from '../lib/site';
import aboutPhoto from '@images/json-drinking-coffee.jpg';

const BIO = [
  "I grew up in Virginia Beach and moved to New York to attend NYU - I've called the city home ever since. Over the past decade, I've had the opportunity to build products across consumer, healthcare, and fintech, working on everything from Broadway ticket lotteries to real-time pharmacy delivery tracking and financial software used by thousands of businesses.",
  "What I enjoy most about engineering isn't just writing code, it's turning ambitious, often ambiguous ideas into polished products that people genuinely enjoy using. I love collaborating with product managers, designers, and engineers to figure out what to build, breaking complex problems into achievable milestones, and shipping value early and often. Whether I'm building a thoughtful user experience, designing backend systems, or leading a cross-functional initiative, my goal is always the same: solve the right problems and leave the product better than I found it.",
  "I'm especially passionate about building software that's elegant, intuitive, accessible, and maintainable. I believe users notice the details, performance is a feature, and the best products come from close collaboration, not silos. Along the way, I've found just as much satisfaction in mentoring engineers, strengthening teams, and helping the people around me do their best work.",
  "Outside of work, you'll usually find me on a pickleball court, experimenting with the perfect cup of coffee, planning my next trip, exploring New York City, or making dad jokes that are only occasionally appreciated.",
  // "Placeholder bio, paragraph one. I'm a full-stack engineer in New York. This is where you say what you actually do all day, in a sentence a recruiter can repeat to a hiring manager without having to translate it first.",
  // 'Placeholder bio, paragraph two. Where you grew up, how you got from a history degree at NYU to writing software for a living, and what made it stick. This is the paragraph people remember, so it should sound like you talking rather than like a résumé summary.',
  // "Placeholder bio, paragraph three. The work you're proudest of and why — the problem, not the job title. One concrete example beats three adjectives here, and it gives an interviewer something to ask about.",
  // "Placeholder bio, paragraph four. What you're building right now, and what you're deliberately learning. Two apps in TestFlight is a good hook: it says you ship on your own time, which is the thing a CV can't.",
  // "Placeholder bio, paragraph five. What you're looking for next, and the kind of team you do your best work on. Be specific enough that the wrong role screens itself out.",
  // "Placeholder bio, paragraph six. The part that isn't about work — espresso, podcasts, wherever the countries counter came from. This is what makes the page feel like a person rather than a profile.",
];

/** The AI row is marked, because it is the one people scan for right now. */
const STACK = [
  { label: 'Languages', items: ['JavaScript', 'TypeScript', 'Python'] },
  {
    label: 'Frontend',
    items: [
      'React',
      'React Native / Expo',
      'Next.js',
      'Astro',
      'Remix',
      'TanStack Query',
      'Storybook',
    ],
  },
  { label: 'Backend', items: ['Node', 'NestJS', 'Django'] },
  { label: 'Data', items: ['PostgreSQL', 'MySQL', 'MongoDB'] },
  { label: 'Testing', items: ['Jest / Vitest', 'Cypress'] },
  {
    label: 'Platform',
    items: ['AWS', 'Docker', 'Kubernetes', 'Terraform', 'Microservices'],
  },
  { label: 'Observability', items: ['Datadog', 'Grafana'] },
  {
    label: 'AI',
    items: ['Claude Code', 'Codex', 'Agentic workflows'],
    accent: true,
  },
];

const STATS = [
  { value: '31', label: 'Countries visited', ph: true },
  { value: '50+', label: 'Podcasts subscribed', ph: true },
  { value: '2', label: 'Apps in TestFlight', ph: false },
  { value: '11', label: 'Years shipping', ph: true },
];
---

<BaseLayout
  pageTitle="About"
  page="about"
  description="Jason Leibowitz — full-stack software engineer, technology evangelist and technical mentor in NYC."
>
  <PageHead eyebrow="About" title="The longer version" />

  <Section>
    <Shell>
      {
        /*
        The bio wraps around its photo. A float is the right tool: the text
        reflows around it rather than sitting in a rigid column. Below 56rem it
        unfloats and goes full width, which is what killed the old page.
      */
      }
      <div class="bio max-w-bio text-read leading-[1.72]">
        <figure class="mb-8 bio:float-right bio:ml-12 bio:w-[360px]">
          <Image
            src={aboutPhoto}
            alt="Jason in front of a painted brick wall"
            width={720}
            densities={[1, 2]}
            class="aspect-4/5 w-full rounded-card object-cover shadow-lift"
          />
          <figcaption class="text-center mt-2 font-mono text-meta text-faint">
            Drinking coffee, what else
          </figcaption>
        </figure>

        {BIO.map((paragraph) => <p class="mb-6 block">{paragraph}</p>)}
      </div>

      <div class="mt-8 flex max-w-bio flex-wrap justify-center gap-2">
        <Button href={RESUME_HREF} variant="primary" icon="lucide:file-down">
          Download resume
        </Button>
        <Button href={`mailto:${EMAIL}`} icon="lucide:mail">Email me</Button>
      </div>
    </Shell>
  </Section>

  <Section id="experience">
    <Shell>
      <SectionHead title="Experience" />
      <Timeline />
      <PhNote>
        Dates, titles and every bullet are placeholder — the repo only recorded
        the order of the companies.
      </PhNote>
    </Shell>
  </Section>

  <Section>
    <Shell>
      <SectionHead title="Stack" />
      {
        /*
        One line per category rather than one long row: scannable by someone
        hunting for a specific technology.
      */
      }
      <dl class="grid gap-4">
        {
          STACK.map((group) => (
            <div class="grid gap-2 card:grid-cols-[132px_minmax(0,1fr)] card:items-baseline card:gap-4">
              <dt class="font-mono text-meta tracking-[0.12em] text-faint uppercase">
                {group.label}
              </dt>
              <dd class="m-0 flex flex-wrap gap-1.5">
                {group.items.map((item) => (
                  <Chip accent={group.accent ? 'violet' : 'none'}>{item}</Chip>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </Shell>
  </Section>

  <Section>
    <Shell>
      <SectionHead title="Beyond the CV" />
      <div
        class="grid gap-4 [grid-template-columns:repeat(auto-fit,minmax(142px,1fr))]"
      >
        {
          STATS.map((stat) => (
            <Panel class="p-6">
              <Ph
                as="b"
                when={stat.ph}
                class="text-gradient block font-display text-[2rem] leading-none font-bold tracking-[-0.04em]"
              >
                {stat.value}
              </Ph>
              <span class="mt-2 block font-mono text-meta tracking-[0.1em] text-faint uppercase">
                {stat.label}
              </span>
            </Panel>
          ))
        }
      </div>
      <PhNote>
        Numbers are placeholder — other ideas: cities lived in, marathons,
        concerts, a "currently reading" slot, a small map.
      </PhNote>
    </Shell>
  </Section>
</BaseLayout>

<style>
  /* Clears the floated photo so the CTA below it doesn't ride up alongside. */
  .bio::after {
    content: '';
    display: block;
    clear: both;
  }
</style>
