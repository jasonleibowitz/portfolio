---
import { Image } from 'astro:assets';
import aboutTwo from '@images/IMG_1374.jpg';
import BaseLayout from '@layouts/BaseLayout.astro';

const pageTitle = 'About Me';
---

<BaseLayout
  pageTitle={pageTitle}
  description="Jason Leibowitz -- full-stack software engineer, technology evangelist, and technical mentor in NYC."
>
  <article class="mt-20">
    <h1 class="my-8 italic">About Me</h1>
    <div class="float-right w-full lg:w-1/3 pb-16 lg:ml-16">
      <Image
        class="rounded"
        alt="Picture of Jason"
        src={aboutTwo}
        width={600}
        densities={[1, 2]}
      />
    </div>
    <div>
      <p class="text-xl leading-relaxed mb-8">
        I'm a full-stack software engineer, technology evangelist, and technical
        mentor living in NYC. I'm currently working at <a
          href="https://carta.com/">Carta</a
        >, working to unlock the power of equity ownership for more people in
        more places. Prior to Carta I previously worked at <a
          href="https://capsule.com/">Capsule Pharmacy</a
        >, <a href="https://www.invitae.com/en">Invitae</a>, <a
          href="https://www.todaytix.com/">TodayTix</a
        >, and more.
      </p>
      <p class="text-xl leading-relaxed mb-8">
        Originally from Virginia Beach, VA, I graduated <a
          href="https://www.nyu.edu/">New York University</a
        > with a degree in History.
      </p>
      <p class="text-xl leading-relaxed mb-8">
        I am most excited about delivering exceptional experiences to customers
        and driving innovation and best practices.
      </p>
    </div>

    <!-- <h2 class="text-center">Technologies</h2> -->
  </article>
</BaseLayout>
