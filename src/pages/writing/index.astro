---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHead from '@components/ui/PageHead.astro';
import Section from '@components/layout/Section.astro';
import SidebarLayout from '@components/layout/SidebarLayout.astro';
import Typography from '@components/ui/Typography.astro';
import PostRow from '@components/PostRow.astro';
import TagRail from '@components/TagRail.astro';
import { getPublished, getPublishedTags } from '@lib/content';
import { WRITING } from '@lib/site';

const posts = await getPublished('blog');
const tags = await getPublishedTags();
---

<BaseLayout
  pageTitle={WRITING.title}
  page="writing"
  description={WRITING.description}
>
  <PageHead eyebrow="Archive" title={WRITING.title} intro={WRITING.intro} />

  <Section>
    <SidebarLayout data-filter-root data-unit="posts">
      <TagRail tags={tags} total={posts.length} />

      <div>
        <Typography
          variant="caption"
          class="mb-4"
          data-filter-count
          aria-live="polite"
        >
          {posts.length} posts
        </Typography>

        <ul>
          {posts.map((post) => <PostRow post={post} />)}
        </ul>

        <p class="py-8 text-muted" data-filter-empty hidden>
          No posts with that tag yet.
        </p>
      </div>
    </SidebarLayout>
  </Section>
</BaseLayout>
