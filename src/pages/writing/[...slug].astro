---
import { render } from 'astro:content';
import PostLayout from '@layouts/PostLayout.astro';
import Heading2 from '@components/markdown/Heading2.astro';
import Heading3 from '@components/markdown/Heading3.astro';
import TextLink from '@components/markdown/TextLink.astro';
import CaptionedImage from '@components/CaptionedImage.astro';
import { getPublished } from '@lib/content';
import { usingSanity } from '@lib/sanity';
import PortableText from '@components/PortableText.astro';
import type { PortableBlock } from '@lib/portable-text';

export async function getStaticPaths() {
  const posts = await getPublished('blog');

  return posts.map((post, index) => ({
    params: { slug: post.id },
    // Sorted newest first, so "next" is the one published before this.
    props: { post, next: posts[index + 1] },
  }));
}

const { post, next } = Astro.props;
// Portable Text is data, so it is rendered rather than compiled. Headings come
// from the blocks themselves when Sanity is the source.
const rendered = usingSanity ? null : await render(post);
// `blog` is one of two schemas depending on CONTENT_SOURCE, so `data` is a
// union and `body` sits on the Sanity side alone. The check is what tells the
// two apart; `usingSanity` is a value, and cannot narrow a type.
const body: PortableBlock[] = 'body' in post.data ? post.data.body : [];
const headings = rendered
  ? rendered.headings
  : (body ?? [])
      .filter((b) => b._type === 'block' && /^h[23]$/.test(b.style ?? ''))
      .map((b) => {
        const text = (b.children ?? []).map((c) => c.text ?? '').join('');
        return {
          depth: Number(b.style!.slice(1)),
          slug: text
            .toLowerCase()
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-|-$/g, ''),
          text,
        };
      });
const Content = rendered?.Content;
---

<PostLayout post={post} headings={headings} next={next}>
  {
    Content ? (
      <Content
        components={{ h2: Heading2, h3: Heading3, a: TextLink, CaptionedImage }}
      />
    ) : (
      <PortableText value={body} />
    )
  }
</PostLayout>
