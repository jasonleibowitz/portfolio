---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import ProjectCard from '@components/ProjectCard.astro';
import Shell from '@components/ui/Shell.astro';
import Section from '@components/ui/Section.astro';
import SectionHead from '@components/ui/SectionHead.astro';
import Panel from '@components/ui/Panel.astro';
import Fact from '@components/ui/Fact.astro';
import { getPublished } from '../lib/content';
import { currentRole } from '../lib/career';

const featured = (await getPublished('projects')).filter(
  (project) => project.data.is_featured
);
---

<BaseLayout
  pageTitle="Home"
  page="home"
  description="Jason Leibowitz — full-stack engineer in New York. Eleven years of products people use every day, plus two mobile apps of my own."
>
  <Hero />

  <Section>
    <Shell>
      <SectionHead
        title="At a glance"
        more={{ label: 'About me', href: '/about/' }}
      />
      <Panel class="px-6 py-2">
        <dl>
          <Fact label="Now">{currentRole()}</Fact>
          <Fact label="Focus">
            Product engineering across web and mobile — design systems,
            developer experience
          </Fact>
          <Fact label="Before">
            Capsule Pharmacy · Invitae · TodayTix · Reserve · TigerSpike
          </Fact>
          <Fact label="Studied">
            New York University · Hebrew University · General Assembly
          </Fact>
          <Fact label="Based">New York City · Eastern Time</Fact>
          <Fact label="Outside work">Coffee, soccer, dad jokes</Fact>
        </dl>
      </Panel>
    </Shell>
  </Section>

  <Section>
    <Shell>
      <SectionHead
        title="What I'm building"
        more={{ label: 'All projects', href: '/projects/' }}
      />
      <div class="grid gap-4 card:grid-cols-2">
        {featured.map((project) => <ProjectCard project={project} />)}
      </div>
    </Shell>
  </Section>
</BaseLayout>
