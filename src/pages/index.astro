---
// Component Imports
import BaseLayout from '@layouts/BaseLayout.astro';
import { HeadshotSocialLinks } from '@components/HeadshotSocialLinks';

// Full Astro Component Syntax:
// https://docs.astro.build/core-concepts/astro-components/
---

<BaseLayout pageTitle="Home">
  <div class="grid place-items-center h-full content-center">
    <HeadshotSocialLinks client:load />
    <h1
      class="bg-gradient-to-r from-orange-500 to-rose-600 bg-clip-text text-transparent"
    >
      Jason Leibowitz
    </h1>
    <p>web developer passionate about design, creativity and soccer.</p>
  </div>
</BaseLayout>
