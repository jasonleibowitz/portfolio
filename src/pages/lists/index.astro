---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHead from '@components/ui/PageHead.astro';
import Section from '@components/layout/Section.astro';
import ListRow from '@components/ListRow.astro';
import { shareCard } from '@lib/og';
import { getPublished } from '@lib/content';
import { LISTS } from '@lib/site';
import Typography from '@components/ui/Typography.astro';

const lists = await getPublished('lists');
---

<BaseLayout
  pageTitle={LISTS.title}
  page="lists"
  description={LISTS.description}
  image={shareCard('lists')}
  imageAlt="Lists on leibowitz.me, with artwork from each one"
>
  <PageHead
    eyebrow={LISTS.eyebrow}
    title={LISTS.headline}
    intro={LISTS.intro}
  />

  <Section>
    {
      /* Hairline-separated rows rather than cards, matching /projects and
        /writing. Each row draws its own top rule and the footer draws the
        page's closing one, so a bottom rule here would land a second hairline
        barely a section's padding above the footer's. */
    }
    {lists.map((list) => <ListRow list={list} />)}

    {
      /* Every list can be a draft at once, which renders a headline, a lead
        and then nothing at all. Reachable today with two entries. */
      lists.length === 0 && (
        <Typography
          variant="body"
          class="border-t border-line py-10 text-muted"
        >
          No lists are published right now. They will be back.
        </Typography>
      )
    }
  </Section>
</BaseLayout>
