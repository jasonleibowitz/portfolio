---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import BlogPost from '@components/BlogPost.astro';

const allLists = await getCollection('lists');

// Display drafts in non-prod environments
const filteredLists = allLists.filter((listEntry) => {
  if (!import.meta.env.PROD) return listEntry;
  return !listEntry.data.draft;
});
const pageTitle = 'Listicles';
---

<BaseLayout pageTitle={pageTitle}>
  <article class="mx-auto my-0">
    <ul class="mt-8">
      {
        filteredLists.map((listEntry) => (
          <BlogPost
            url={`/lists/${listEntry.slug}`}
            title={listEntry.data.title}
            pubDate={listEntry.data.pubDate}
          />
        ))
      }
    </ul>
  </article>
</BaseLayout>
