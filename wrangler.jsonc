{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-08-09",

  // No `main`, so there is no Worker script and each request reads an asset
  // directly. Cloudflare does not bill static asset requests.
  "assets": {
    "directory": "./dist",

    // Astro makes addresses that end with a slash (`/writing/foo/index.html`),
    // which the default mode `auto-trailing-slash` finds. An address that has
    // no asset gets `dist/404.html`, which `src/pages/404.astro` makes. Without
    // this line, Cloudflare sends an empty 404 and no person sees that page.
    "not_found_handling": "404-page",
  },

  // A deploy applies this, thus CLOUDFLARE_API_TOKEN needs
  // `Zone: Workers Routes: Edit` on the zone. `www` is absent on purpose: a
  // custom domain makes the Worker answer for the hostname, and a Worker with
  // no `main` cannot answer a redirect, so a zone rule redirects it instead.
  "routes": [{ "pattern": "leibowitz.me", "custom_domain": true }],

  // Retires `portfolio.<subdomain>.workers.dev`, which served the same build as
  // the apex and stopped sending `noindex` at production. leibowitz.me is the
  // only address.
  "workers_dev": false,

  // Preview URLs for each version. CI names each one `pr-<number>` with
  // `--preview-alias`. Not redundant beside the line above: `preview_urls`
  // defaults to `workers_dev`, so deleting it takes every preview down too.
  "preview_urls": true,
}
