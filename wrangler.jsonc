{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-08-09",

  // No `main`: there is no Worker script, so every request is served straight
  // from the asset store. Static asset requests are unbilled, and nothing runs
  // server-side that the zero-JS build does not already produce.
  "assets": {
    "directory": "./dist",

    // Astro emits directory-style URLs (`/writing/foo/index.html`), which the
    // default `auto-trailing-slash` handling matches. There is no `404.astro`
    // yet, so there is no `404.html` to serve -- `none` returns a bare 404
    // rather than silently serving the wrong page.
    "not_found_handling": "none",
  },

  // Per-version preview URLs. A version's alias is assigned at upload time by
  // `--preview-alias`, which CI sets to `pr-<number>`.
  "preview_urls": true,
}
