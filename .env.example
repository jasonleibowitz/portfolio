# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so it must
# never carry a real value.
#
# Nothing here is needed to run `pnpm dev` or `pnpm build` against the .mdx
# files, which is still the default. Everything below is either for a script or
# for reading content from Sanity instead.


# ─── The site itself ─────────────────────────────────────────────────────────

# Overrides `site` in astro.config.mjs, which sets the canonical tag, the
# og:image URL, every RSS link and the Sitemap line in robots.txt. CI sets it
# per deployment so a preview does not advertise production's address.
#
# Rarely needed locally. Defaults to https://leibowitz.me.
SITE_URL=


# ─── Which content source the site builds from ───────────────────────────────

# `sanity` reads posts and lists from Sanity; anything else reads the .mdx files
# in src/content. Absent means files, which is the default while the two are
# being compared.
CONTENT_SOURCE=

# `drafts` renders unpublished Sanity edits as if they were live, which is what
# makes a preview a preview. Absent means `published`, and a production build
# must leave it absent.
SANITY_PERSPECTIVE=

# Keeps entries flagged `draft` in the build. Separate from the perspective
# above: that one is Sanity's publish state, this is the site's own field. Set
# on preview builds only.
SHOW_DRAFTS=


# ─── Sanity, read side (the Astro build) ─────────────────────────────────────

# From sanity.io/manage. Not a secret -- it appears in every image URL the site
# serves -- but it is configuration, so it lives here rather than in the code.
SANITY_PROJECT_ID=
SANITY_DATASET=production

# API token with the **Viewer** role, from Manage -> API -> Tokens.
#
# Read-only on purpose: the build only ever fetches published content, and a
# token that cannot write is one that cannot be misused if it leaks. Content is
# imported through the Sanity CLI under your own credentials instead, so no
# write token has to exist anywhere.
#
# Not needed at all while the dataset is public, which it is by default.
SANITY_READ_TOKEN=


# ─── Sanity, write side (the studio) ─────────────────────────────────────────

# Everything prefixed `SANITY_STUDIO_` is compiled into the studio bundle and is
# readable by anyone who opens the page. Treat all of them as public.

# The same project, named again for the studio's own build.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Google Maps API key, used by the "Places (Google)" list source to search for
# venues and pull their photographs. Enable **Places API (New)** on the project.
#
# This one ships in the bundle, so restrict it by HTTP referrer in Google Cloud
# to localhost:3333 and your deployed studio host. An unrestricted key can be
# spent by anyone who views source.
#
# Optional. Without it the "Places (OpenStreetMap)" source still works, needing
# no key at all, at the cost of returning no photographs.
SANITY_STUDIO_GOOGLE_MAPS_KEY=

# Where the "Open preview" button on each document points. Defaults to
# http://localhost:4321, so set this only to aim the studio at a deployed
# preview instead of the local dev server.
SANITY_STUDIO_PREVIEW_ORIGIN=


# ─── Scripts ─────────────────────────────────────────────────────────────────

# TMDB v4 read access token, used by scripts/list-artwork.mjs to fetch poster
# artwork for lists with `thumb: 'poster'`. Read-only; it cannot write to the
# account. Get one at https://www.themoviedb.org/settings/api
#
# Only needed to add artwork to a poster list. Nothing in `pnpm build` reads it,
# because the artwork it fetches is committed rather than fetched at build time.
#
# Redundant for anything managed in Sanity, where the studio's own artwork
# picker does this. Keep it while the file-backed source is still live.
TMDB_API_KEY=
