# Copy this file to `.env`. Do not put real values in this file.
# `.env` is gitignored. This file is not.
#
# The default build reads the .mdx files. It needs none of these values.

# Sets the canonical tag, the og:image URL and the RSS links.
# CI sets this for each deployment. Default: https://leibowitz.me
SITE_URL=

# Set to `sanity` to read content from Sanity. Empty reads the .mdx files.
CONTENT_SOURCE=

# Set to `drafts` to show unpublished Sanity edits. Keep it empty in production.
SANITY_PERSPECTIVE=

# Set to `true` to keep entries that have `draft: true`. Preview builds only.
SHOW_DRAFTS=

# From sanity.io/manage. Neither value is a secret.
#
# `PUBLIC_` is what lets the studio at /admin read them: Astro compiles only
# that prefix into the browser bundle, and the studio runs in the browser.
# Without the project id there is no /admin, and the site reads the .mdx files.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Token with the Viewer role, from Manage > API > Tokens.
# Read-only, and the one value here that is a secret, so it has no prefix and
# stays on the server. A public dataset does not need it.
SANITY_READ_TOKEN=

# For the "Places (Google)" list source. Enable Places API (New).
# It reaches the browser, so restrict the key by HTTP referrer or other people
# can spend it. Optional: "Places (OpenStreetMap)" needs no key, but gives no
# photos.
PUBLIC_SANITY_GOOGLE_MAPS_KEY=

# TMDB v4 read token, for scripts/list-artwork.mjs. Poster lists only.
# The Sanity artwork picker replaces this script.
TMDB_API_KEY=
