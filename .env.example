# Copy this file to `.env`. Do not put real values in this file.
# `.env` is gitignored. This file is not.
#
# The default build reads the .mdx files. It needs none of these values.

# Sets the canonical tag, the og:image URL and the RSS links.
# CI sets this for each deployment. Default: https://leibowitz.me
SITE_URL=

# Set to `sanity` to read content from Sanity. Empty reads the .mdx files.
CONTENT_SOURCE=

# Set to `drafts` to show unpublished Sanity edits. Keep it empty in production.
SANITY_PERSPECTIVE=

# Set to `true` to keep entries that have `draft: true`. Preview builds only.
SHOW_DRAFTS=

# From sanity.io/manage. The project id is public.
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Token with the Viewer role, from Manage > API > Tokens.
# Read-only. A public dataset does not need it.
SANITY_READ_TOKEN=

# The studio compiles each SANITY_STUDIO_ value into its bundle.
# All of them are public.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# For the "Places (Google)" list source. Enable Places API (New).
# Restrict the key by HTTP referrer, or other people can spend it.
# Optional: "Places (OpenStreetMap)" needs no key, but gives no photos.
SANITY_STUDIO_GOOGLE_MAPS_KEY=

# Programmable Search Engine id, for the "{name} logo" image search.
# Enable Custom Search API and add it to the key restrictions above.
# Optional. Without it, logos come from the venue's own website.
SANITY_STUDIO_GOOGLE_CSE_ID=

# Where the "Open preview" button points. Default: http://localhost:4321
SANITY_STUDIO_PREVIEW_ORIGIN=

# TMDB v4 read token, for scripts/list-artwork.mjs. Poster lists only.
# The Sanity artwork picker replaces this script.
TMDB_API_KEY=
